# Smoke: Scene 5, the inquiry. After a disruption, the shipper asks why
# with `ulpnode ask`; the operator verifies, authorizes, answers from that
# booking's records with its (fake) model, and signs the answer, which
# cites events and an alert the shipper holds signed.
set -euo pipefail
. "$(dirname "$0")/lib.sh"

work="$(mktemp -d)"
trap 'smoke_stop; rm -rf "$work"' EXIT

demo_build "$work"
demo_ports
demo_setup "$work" 10
smoke_start "$work"

if ! out="$("$work/bin/ulpnode" book --config "$work/shipper.yaml" --operator ocean-blue.example --request "$work/booking.json" --yes 2>"$work/book.log")"; then
  smoke_fail "$work" "booking failed"
fi
ref="$(sed -n 's/.*"carrier_booking_reference": "\([^"]*\)".*/\1/p' <<<"$out")"
[[ -n "$ref" ]] || smoke_fail "$work" "no booking reference in: $out"

smoke_wait_for "$work" "$work/shipper.log" '"msg":"event recorded".*"event":"TRANSPORT ARRI EST"' 15
"$work/bin/ulpctl" disrupt --config "$work/operator.yaml" --booking "$ref" --delay 72h \
  --reason "Engine repair, unscheduled call at Halifax." >/dev/null || smoke_fail "$work" "ulpctl disrupt failed"
smoke_wait_for "$work" "$work/shipper.log" '"msg":"alert recorded"' 10

if ! answer="$("$work/bin/ulpnode" ask --config "$work/shipper.yaml" --booking "$ref" \
  "What caused the delay on this shipment, and how firm is the new ETA?" 2>&1)"; then
  smoke_fail "$work" "ulpnode ask failed: $answer"
fi
echo "$answer"
grep -q "ocean-blue.example answered (llm" <<<"$answer" || smoke_fail "$work" "the answer wasn't the model's"
grep -q "Halifax" <<<"$answer" || smoke_fail "$work" "the answer doesn't mention the cause"
grep -q "(held, signed)" <<<"$answer" || smoke_fail "$work" "the answer cites nothing the shipper holds"
if grep -q "(not held)" <<<"$answer"; then smoke_fail "$work" "the answer cites records the shipper doesn't hold"; fi

grep -qE '"intent":"ulp.tnt.inquiry".*"via":"a2a".*"verified":true.*"outcome":"accepted"' "$work/operator.log" ||
  smoke_fail "$work" "the operator logged no verified, accepted inquiry over A2A"
grep -qE '"msg":"model call".*"booking":"'"$ref"'".*"outcome":"ok"' "$work/operator.log" ||
  smoke_fail "$work" "the operator logged no model call"

# The responder ran with the built-in skill and Ocean Blue's own.
grep -qE '"msg":"model call".*"skills":\["shipment-inquiry@[0-9a-f]{12}","delay-phrasing@[0-9a-f]{12}"\]' "$work/operator.log" ||
  smoke_fail "$work" "the model call didn't log both agent skills"

# The operator's agent card lists the skill the inquiry went to.
curl -fsS "http://127.0.0.1:$OP_PORT/.well-known/agent-card.json" | grep -q '"id":"shipment-inquiry"' ||
  smoke_fail "$work" "the operator's agent card doesn't list shipment-inquiry"

# Asking about a booking the shipper doesn't hold never leaves its node.
if "$work/bin/ulpnode" ask --config "$work/shipper.yaml" --booking OB-BKG-9999 "Where is it?" >/dev/null 2>&1; then
  smoke_fail "$work" "asked about a booking the shipper doesn't hold"
fi
inquiries="$(grep -c '"intent":"ulp.tnt.inquiry"' "$work/operator.log" || true)"
[[ "$inquiries" == 1 ]] || smoke_fail "$work" "the operator received $inquiries inquiries, want 1"

echo "✓ smoke/inquiry: a signed question, a grounded and signed answer citing held events"
