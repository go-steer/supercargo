# Smoke: two nodes with persistence files (docs/DESIGN.md, A.12) are
# stopped and started again. Each still holds the booking made before,
# the operator numbers the next one on after it, and the booking can
# still be cancelled.
set -euo pipefail
. "$(dirname "$0")/lib.sh"

work="$(mktemp -d)"
trap 'smoke_stop; rm -rf "$work"' EXIT

demo_build "$work"
demo_ports
demo_setup "$work" 0.01 # slow: nothing moves for minutes
echo "persistence: { file: $work/ob.db }" >>"$work/operator.yaml"
echo "persistence: { file: $work/cy.db }" >>"$work/shipper.yaml"
smoke_start "$work"

book() {
  "$work/bin/ulpnode" book --config "$work/shipper.yaml" --operator ocean-blue.example --request "$work/booking.json" --yes 2>>"$work/book.log" |
    sed -n 's/.*"carrier_booking_reference": "\([^"]*\)".*/\1/p' | head -1
}
first="$(book)"
[[ -n "$first" ]] || smoke_fail "$work" "booking failed"
echo "booked $first"

smoke_stop
smoke_start "$work"
echo "both nodes restarted"

curl -fsS --unix-socket "$work/cy.sock" http://control/shipments | grep -q "\"bookingRef\":\"$first\"" ||
  smoke_fail "$work" "Cymbal lost $first in the restart"
curl -fsS --unix-socket "$work/ob.sock" http://control/bookings | grep -q "\"bookingRef\":\"$first\"" ||
  smoke_fail "$work" "Ocean Blue lost $first in the restart"

second="$(book)"
[[ -n "$second" && "$second" != "$first" ]] || smoke_fail "$work" "the next booking after the restart: '$second' (first $first)"
echo "booked $second after the restart"

code="$(curl -sS -o "$work/out.json" -w '%{http_code}' --unix-socket "$work/cy.sock" -X POST "http://control/shipments/ocean-blue.example/$first/cancel")"
[[ $code == 200 ]] && grep -q '"status":"cancelled"' "$work/out.json" || smoke_fail "$work" "cancelling $first after the restart: HTTP $code $(cat "$work/out.json")"

echo "✓ smoke/restart: both nodes kept their records through a restart; $first then $second; $first cancelled after it"
