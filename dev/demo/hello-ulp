# "Hello ULP", the milestone 3 demo, interactive: Ocean Blue (an operator)
# and Cymbal Shoes (a shipper) on localhost. You book, watch the voyage's
# events arrive signed and verified, then disrupt it and watch the alert.
#
#   dev/demo/hello-ulp [--tmux] [DIR]
#
# Builds the binaries and writes keys and configs into DIR (default
# $TMPDIR/supercargo-demo; keys are kept between runs), then prints the
# command for each of four terminals, or opens them in a tmux session with
# --tmux. dev/smoke/push runs the same demo, scripted.
#
# Environment: OP_PORT (8441), SH_PORT (8442), HOURS_PER_SECOND (1: the
# voyage departs about half a minute after booking and arrives about two
# and a half minutes later).
set -euo pipefail
. "$(dirname "$0")/../smoke/lib.sh"

tmux=false
if [[ "${1:-}" == "--tmux" ]]; then
  tmux=true
  shift
fi
dir="${1:-${TMPDIR:-/tmp}/supercargo-demo}"
mkdir -p "$dir"
dir="$(cd "$dir" && pwd)"

OP_PORT="${OP_PORT:-8441}"
SH_PORT="${SH_PORT:-8442}"
hps="${HOURS_PER_SECOND:-1}"

echo "Building ulpnode and ulpctl..."
demo_build "$dir"
demo_setup "$dir" "$hps"

# Shell-quoted, so a DIR with spaces still pastes and runs.
q="$(printf %q "$dir")"
operator="$q/bin/ulpnode serve --config $q/operator.yaml"
shipper="$q/bin/ulpnode serve --config $q/shipper.yaml"
book="$q/bin/ulpnode book --config $q/shipper.yaml --operator ocean-blue.example --request $q/booking.json"
disrupt="$q/bin/ulpctl disrupt --config $q/operator.yaml --booking OB-BKG-1042 --delay 72h --reason \"Engine repair, unscheduled call at Halifax.\""
ask="$q/bin/ulpnode ask --config $q/shipper.yaml --booking OB-BKG-1042 \"What caused the delay, and how firm is the new ETA?\""

if $tmux; then
  command -v tmux >/dev/null || { echo "hello-ulp: tmux is not installed; run without --tmux" >&2; exit 1; }
  session=hello-ulp
  tmux kill-session -t "$session" 2>/dev/null || true
  tmux new-session -d -s "$session" -x 200 -y 50 "$operator"
  tmux split-window -h -t "$session" "$shipper"
  tmux split-window -v -t "$session:0.0" "bash"
  tmux split-window -v -t "$session:0.1" "bash"
  tmux select-pane -t "$session:0.0" -T "Ocean Blue node (operator)"
  tmux select-pane -t "$session:0.1" -T "Cymbal Shoes node (shipper)"
  sleep 1 # let the nodes start before the commands are typed
  tmux send-keys -t "$session:0.2" "$book"
  tmux send-keys -t "$session:0.3" "$disrupt"
  tmux select-pane -t "$session:0.2"
  echo "In tmux: press Enter in the lower-left pane to book (answer y), and in the"
  echo "lower-right pane once Cymbal's log shows the departure, to disrupt."
  echo "Then ask Ocean Blue why, in the lower-left pane: $ask"
  exec tmux attach -t "$session"
fi

cat <<EOF

Hello ULP is set up in $dir. Open four terminals:

  1. Ocean Blue's node (the operator):
       $operator

  2. Cymbal Shoes' node (the shipper):
       $shipper

  3. Book, as Cymbal Shoes (it asks before sending; answer y):
       $book

     Ocean Blue confirms OB-BKG-1042 and starts the voyage at $hps simulated
     hour(s) per second. Watch Cymbal's log: each event arrives as an
     "envelope" line (verified=true, outcome=accepted) and an
     "event recorded" line: gate-in, load, departure, estimated arrival...

  4. Once the vessel has departed, disrupt the voyage, as the presenter:
       $disrupt

     Cymbal's log shows the signed delay alert: "alert recorded",
     severity=high, the ETA moving from the 13th to the 16th.

  5. Ask Ocean Blue why, as Cymbal Shoes:
       $ask

     Ocean Blue's log shows the inquiry verified, authorized and answered
     (a "model call" line; the fake model needs no API key), and the answer
     cites events and the alert that Cymbal holds signed.

Run it again from step 1 with a fresh booking by restarting both nodes
(they keep everything in memory).
EOF
