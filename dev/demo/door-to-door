# The door-to-door demo (docs/proposals/door-to-door-forwarder.md, phase 1),
# on localhost: Cymbal Shoes orders a container from its Tilburg warehouse to
# Cymbal Calçados in Cajamar, Brazil; Meridian Forwarding books the three
# legs (Polder Haulage's truck over EDI, Ocean Blue's ship and Serra
# Transportes' truck over ULP) and tells Cymbal one story from them. Serra's
# leg is priced below Brazil's ANTT minimum freight (checked with the QualP
# mock, ulpmock qualp), so booking waits until Mia sets its rate.
#
#   dev/demo/door-to-door up [DIR]       build, start the four nodes and Polder, print the UIs
#   dev/demo/door-to-door order [DIR]    Cymbal orders (POST /orders)
#   dev/demo/door-to-door rate [DIR]     Meridian's person sets Serra's rate above the ANTT floor
#   dev/demo/door-to-door book [DIR]     Meridian's person confirms the plan: the legs are booked
#   dev/demo/door-to-door disrupt [DIR]  the ship is 72 hours late (ulpctl disrupt)
#   dev/demo/door-to-door confirm [DIR]  Meridian's person confirms re-timing the truck
#   dev/demo/door-to-door status [DIR]   the order as Cymbal and Meridian hold it
#   dev/demo/door-to-door down [DIR]     stop everything
#
# DIR defaults to $TMPDIR/supercargo-d2d; keys are kept between runs, the
# companies' state isn't (it's in memory). dev/smoke/door-to-door runs the
# same journey, scripted. Needs curl, python3 and GNU date (Linux).
#
# Environment: D2D_PORT (8451: Cymbal; Meridian, Ocean Blue, Serra and the
# QualP mock take the next four), HOURS_PER_SECOND (8: the journey takes about a minute; the companies share one simulated clock, from their first bookings),
# ULP_LLM and ULP_LLM_MODEL (as for hello-ulp: fake by default).
set -euo pipefail
. "$(dirname "$0")/../smoke/lib.sh"

cmd="${1:-}"
case "$cmd" in
  up | down | order | rate | book | disrupt | confirm | status) ;;
  *) sed -n '/^# The door-to-door demo/,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 2 ;;
esac
dir="${2:-${TMPDIR:-/tmp}/supercargo-d2d}"
mkdir -p "$dir"
dir="$(cd "$dir" && pwd)"
chmod 700 "$dir" # the signing keys and the control sockets live here

base="${D2D_PORT:-8451}"
CY=$base MF=$((base + 1)) OB=$((base + 2)) SR=$((base + 3)) QP=$((base + 4))
hps="${HOURS_PER_SECOND:-8}"
ui() { printf '%s/ui/' "$(web_origin "$1")"; }

ctl() { curl -fsS --max-time "${3:-60}" --unix-socket "$dir/$1.sock" "http://control$2" "${@:4}"; }
post() { ctl "$1" "$2" 120 -X POST -H 'Content-Type: application/json' ${3:+--data "$3"}; }
order_ref() { cat "$dir/order.ref" 2>/dev/null || { echo "door-to-door: no order yet (run: order)" >&2; exit 1; }; }

setup() {
  local llm k
  case "${ULP_LLM:-fake}" in
    fake) llm="{ provider: fake }" ;;
    anthropic) llm="{ provider: anthropic${ULP_LLM_MODEL:+, model: $ULP_LLM_MODEL} }" ;;
    gemini) llm="{ provider: gemini, model: ${ULP_LLM_MODEL:-gemini-3.8-flash} }" ;;
    vertex-claude) llm="{ provider: anthropic, backend: vertex${ULP_LLM_MODEL:+, model: $ULP_LLM_MODEL} }" ;;
    vertex-gemini) llm="{ provider: gemini, backend: vertex, model: ${ULP_LLM_MODEL:-gemini-3.8-flash} }" ;;
    *) echo "door-to-door: ULP_LLM must be fake, anthropic, gemini, vertex-claude or vertex-gemini" >&2; exit 1 ;;
  esac
  rm -rf "$dir/edi" # a past run's files mustn't match this run's references
  mkdir -p "$dir/edi/to-polder" "$dir/edi/from-polder"
  chmod 700 "$dir/edi" "$dir/edi/to-polder" "$dir/edi/from-polder"
  for k in cy mf ob sr; do
    [[ -f "$dir/$k.pem" ]] || "$dir/bin/ulpnode" keygen --kid "$k-1" --out "$dir/$k.pem" >/dev/null
  done
  local all="cymbal-shoes.example meridian-forwarding.example ocean-blue.example serra-transportes.example"
  local peers="peers:
  cymbal-shoes.example: 127.0.0.1:$CY
  meridian-forwarding.example: 127.0.0.1:$MF
  ocean-blue.example: 127.0.0.1:$OB
  serra-transportes.example: 127.0.0.1:$SR"
  # node FILE DOMAIN NAME PORT KID PERSONA BODY
  node() {
    local others d
    others="$(for d in $all; do [[ $d == "$2" ]] || printf '%s, ' "$d"; done)"
    cat >"$dir/$1.yaml" <<EOF
domain: $2
name: $3
listen: 127.0.0.1:$4
tls: { mode: insecure-dev }
keys: [{ kid: $5-1, privateKeyFile: $dir/$5.pem }]
$peers
partners: [${others%, }]
control: { socket: $dir/$5.sock }
llm: $llm
web:
  auth: demo             # no password: local demos only
  personas:
    - $6$(web_hosts "$4")
  frameAncestors: ["$(web_origin "$MF")"]   # Meridian's presenter page
$7
EOF
  }
  # Cymbal's private context: the Brazil launch, 23 days out. The journey
  # (cargo ready tomorrow) takes 21 days, so it makes it, and an order its
  # assistant drafts two days before it fits; 72 hours late, it doesn't.
  # Never in an envelope (and nothing here may appear in the order, or the
  # guard refuses to send it).
  local launch
  launch="$(date -u -d '+23 days' +%F)"
  cat >"$dir/business.yaml" <<EOF
shipments:
  - shipperRef: CY-PO-55120
    requiredBy: $launch
    receivingSlot: { date: $launch, window: "08:00-12:00", warehouse: "Brazil launch stock, dock 2" }
    notes: "Brazil launch: the São Paulo stores open with this stock"
notes:
  - "Tell the launch team about any delay that puts the launch at risk"
  - "1,200 pairs of the launch line are already in the São Paulo store room: enough for a partial launch"
EOF
  # Cymbal's address book: its forwarder, and its doors (what an order its
  # assistant drafts goes between).
  cat >"$dir/address-book.yaml" <<'EOF'
entries:
  - domain: meridian-forwarding.example
    name: Meridian Forwarding
    roles: [forwarder]
    description: Our forwarder, door to door to Brazil.
places:
  - id: tilburg-warehouse
    name: Tilburg warehouse
    party: { name: Cymbal Shoes B.V., domain: cymbal-shoes.example, identifiers: [{ scheme: EORI, value: NL123456789 }] }
    place: { type: door, un_location_code: NLTLB, address: { street: Ringbaan Oost 100, postal_code: 5013 CD, locality: Tilburg, country: NL } }
  - id: cajamar-dc
    name: Cajamar DC
    party: { name: Cymbal Calçados Ltda, identifiers: [{ scheme: "BR:CNPJ", value: 12.345.678/0001-90 }] }
    place: { type: door, facility: "Cymbal Calçados DC, dock 2", un_location_code: BRSAO, address: { street: "Rodovia Anhanguera, km 33", locality: Cajamar, region: SP, country: BR } }
EOF
  node cymbal cymbal-shoes.example "Cymbal Shoes" "$CY" cy '{ id: alex, name: Alex, title: "Logistics", roles: [shipper] }' "role: shipper
addressBook: { file: $dir/address-book.yaml }
business: { file: $dir/business.yaml }   # private: never in an envelope
docks: { mock: \"Dock scheduling (simulated)\", site: Cajamar DC, zone: America/Sao_Paulo, docks: [Dock 1, Dock 2, Dock 3] }"
  node meridian meridian-forwarding.example "Meridian Forwarding" "$MF" mf '{ id: mia, name: Mia, title: "Forwarding desk", roles: [operator, shipper] }' "  presenter:
    panels:
      - { name: \"Cymbal Shoes · shipper\", url: \"$(ui "$CY")\" }
      - { name: \"Meridian · forwarder\", url: \"$(ui "$MF")\" }
      - { name: \"Ocean Blue · ocean\", url: \"$(ui "$OB")\" }
      - { name: \"Serra · road\", url: \"$(ui "$SR")\" }
roles: [operator, shipper]
forwarder:
  refPrefix: MF
  freight:               # Brazil's ANTT floors and tolls, from QualP (here, its mock)
    qualp: { url: \"http://127.0.0.1:$QP\", tokenEnv: QUALP_TOKEN, label: \"QualP (simulated)\" }
  edi:                   # Polder Haulage has no node: EDIFACT files
    - { carrier: polder-haulage.example, id: polder-haulage.example, outbox: $dir/edi/to-polder, inbox: $dir/edi/from-polder, zone: Europe/Amsterdam, transit: 3h }
  lanes:                 # the routing guide
    - from: NLTLB
      to: BRSAO
      legs:
        - { mode: road, carrier: polder-haulage.example, name: Polder Haulage, to: NLRTM, facility: Euromax terminal, edi: true }
        - { mode: ocean, carrier: ocean-blue.example, name: Ocean Blue, to: BRSSZ, facility: Santos Brasil Tecon terminal }
        - { mode: road, carrier: serra-transportes.example, name: Serra Transportes, to: BRSAO,
            freight: { rate: 1050, axles: 5, loadType: conteineirizada, table: A, from: \"Santos, SP\" } }   # R$, under the floor
"
  node ocean ocean-blue.example "Ocean Blue" "$OB" ob '{ id: sam, name: Sam, title: "Ops desk", roles: [operator] }' "role: operator
operator: { refPrefix: OB-BKG, containerPrefix: OCBU, vessel: Ocean Blue Aurora, voyage: 42W, departureHour: 18, transit: 380h }
simulator: { hoursPerSecond: $hps, clock: shared }"
  node serra serra-transportes.example "Serra Transportes" "$SR" sr '{ id: rita, name: Rita, title: "Dispatch", roles: [operator] }' "role: operator
operator:
  refPrefix: SR-BKG
  road:
    transit: 30h
    cte: { cnpj: \"12345678000190\", state: 35, mdfe: true }
    tms: \"TMS (simulated)\"                         # the systems behind Serra's node: mocks
    risk: { mock: \"Risk manager (simulated)\" }
    tollVoucher: { mock: \"Vale-Pedágio (simulated)\" }
simulator: { hoursPerSecond: $hps, clock: shared }"
}

up() {
  down quiet
  echo "Building..."
  demo_build "$dir"
  setup
  : >"$dir/pids"
  export QUALP_TOKEN="${QUALP_TOKEN:-demo}" # the mock's; a real QualP token stays in the environment
  nohup "$dir/bin/ulpmock" qualp --listen "127.0.0.1:$QP" --token-env QUALP_TOKEN >/dev/null 2>"$dir/qualp.log" &
  echo $! >>"$dir/pids"
  local n
  for n in cymbal meridian ocean serra; do
    nohup "$dir/bin/ulpnode" serve --config "$dir/$n.yaml" --log-format json >/dev/null 2>"$dir/$n.log" &
    echo $! >>"$dir/pids"
  done
  local up
  for p in "$CY" "$MF" "$OB" "$SR"; do
    up=false
    for _ in $(seq 1 100); do curl -fsS "http://127.0.0.1:$p/.well-known/ulp" >/dev/null 2>&1 && { up=true; break; }; sleep 0.1; done
    $up || { echo "door-to-door: the node on port $p didn't come up (port taken? see $dir/*.log)" >&2; down quiet; exit 1; }
  done
  nohup "$dir/bin/ulpmock" edifact --id polder-haulage.example --partner meridian-forwarding.example \
    --in "$dir/edi/to-polder" --out "$dir/edi/from-polder" --ecmr-prefix ECMR-NL-2026 --zone Europe/Amsterdam \
    --hours-per-second "$hps" --clock shared --tick 200ms >/dev/null 2>"$dir/polder.log" &
  echo $! >>"$dir/pids"
  rm -f "$dir/order.ref"
  cat <<EOF

The door-to-door demo is running ($dir; logs in *.log).

  Browser UIs (sign in as the persona):
    Cymbal Shoes        $(ui "$CY")   (Alex)
    Meridian Forwarding $(ui "$MF")   (Mia)
    Ocean Blue          $(ui "$OB")   (Sam)
    Serra Transportes   $(ui "$SR")   (Rita)
    All four:           $(web_origin "$MF")/ui/presenter

  Then, step by step:
    $0 order     Cymbal orders Tilburg → Cajamar
    $0 rate      Meridian sets Serra's rate above the ANTT floor (or ask its assistant)
    $0 book      Meridian books Polder (EDI), Ocean Blue and Serra
    $0 disrupt   Ocean Blue's ship is 72 hours late
    $0 confirm   Meridian re-times Serra's truck
    $0 down      stop
EOF
}

down() {
  [[ -f "$dir/pids" ]] || return 0
  local p pids
  pids="$(cat "$dir/pids")"
  for p in $pids; do kill "$p" 2>/dev/null || true; done
  for p in $pids; do # wait for them, so a new 'up' gets the ports
    for _ in $(seq 1 50); do kill -0 "$p" 2>/dev/null || break; sleep 0.1; done
  done
  rm -f "$dir/pids"
  [[ "${1:-}" == quiet ]] || echo "Stopped."
}

order() {
  local latest ready out ref
  latest="$(date -u -d '+60 days' +%Y-%m-%dT12:00:00Z)"
  ready="$(date -u -d '+1 day' +%Y-%m-%dT06:00:00Z)"   # as Cymbal's assistant would put it
  out="$(post cy /orders '{"forwarder": "meridian-forwarding.example", "order": {
    "shipper_reference": "CY-PO-55120",
    "incoterms": {"rule": "DAP", "version": "2020", "named_place": "Cymbal Calçados DC, Cajamar"},
    "shipper": {"name": "Cymbal Shoes B.V.", "domain": "cymbal-shoes.example", "identifiers": [{"scheme": "EORI", "value": "NL123456789"}]},
    "consignee": {"name": "Cymbal Calçados Ltda", "identifiers": [{"scheme": "BR:CNPJ", "value": "12.345.678/0001-90"}]},
    "place_of_receipt": {"type": "door", "un_location_code": "NLTLB", "earliest": "'"$ready"'",
      "address": {"street": "Ringbaan Oost 100", "postal_code": "5013 CD", "locality": "Tilburg", "country": "NL"}},
    "place_of_delivery": {"type": "door", "facility": "Cymbal Calçados DC, dock 2", "un_location_code": "BRSAO", "latest": "'"$latest"'",
      "address": {"street": "Rodovia Anhanguera, km 33", "locality": "Cajamar", "region": "SP", "country": "BR"}},
    "containers": [{"equipment_size_type": "45G1", "count": 1, "gross_weight_kg": 12000}],
    "cargo": {"description": "Footwear (sneakers)", "hs_code": "6404"},
    "subscription": {"endpoint": "http://cymbal-shoes.example/ulp", "intents": ["ulp.tnt.event", "ulp.tnt.alert"]}}}')"
  ref="$(sed -n 's/.*"forwarder_reference":"\([^"]*\)".*/\1/p' <<<"$out")"
  [[ -n "$ref" ]] || { echo "door-to-door: no order reference in $out" >&2; exit 1; }
  echo "$ref" >"$dir/order.ref"
  echo "Meridian took the order: $ref, pending (the plan follows)."
}

rate() {
  local ref out
  ref="$(order_ref)"
  out="$(post mf "/orders/$ref/rate" '{"leg":3,"rate":1180}')"
  grep -q '"status":"ok"' <<<"$out" || { echo "door-to-door: the rate doesn't hold: $out" >&2; exit 1; }
  echo "Serra's leg for $ref: R\$ 1180, above the ANTT floor."
}

book() {
  local ref out
  ref="$(order_ref)"
  echo "Meridian's plan for $ref:"
  ctl mf "/orders/$ref/plan" | tr '{' '\n' | sed -n 's/.*"name":"\([^"]*\)","from":"\([^"]*\)","to":"\([^"]*\)".*/  \1: \2 → \3/p'
  out="$(post mf "/orders/$ref/book")"
  grep -q '"status":"confirmed"' <<<"$out" || { echo "door-to-door: booking failed: $out" >&2; exit 1; }
  echo "Booked and answered: Cymbal holds $ref, confirmed with three legs."
}

disrupt() {
  local ship
  ship="$(ctl mf /shipments | grep -o '"bookingRef":"OB-BKG-[0-9]*"' | head -1 | cut -d'"' -f4)"
  [[ -n "$ship" ]] || { echo "door-to-door: no ocean leg yet (run: book)" >&2; exit 1; }
  "$dir/bin/ulpctl" disrupt --config "$dir/ocean.yaml" --booking "$ship" --delay 72h --reason "Engine repair at Las Palmas." >/dev/null
  echo "Ocean Blue: $ship is 72 hours late. Watch Meridian's proposal and Cymbal's alert."
}

confirm() {
  local ref id out
  ref="$(order_ref)"
  for _ in $(seq 1 50); do
    id="$(ctl mf "/orders/$ref/proposals" | python3 -c 'import json, sys
print(next((p["id"] for p in json.load(sys.stdin).get("proposals", []) if p["status"] == "proposed"), ""))')"
    [[ -n "$id" ]] && break
    sleep 0.2
  done
  [[ -n "$id" ]] || { echo "door-to-door: no open proposal (run: disrupt)" >&2; exit 1; }
  out="$(post mf "/proposals/$id/confirm")"
  grep -q '"status":"confirmed"' <<<"$out" || { echo "door-to-door: not confirmed: $out" >&2; exit 1; }
  echo "Serra re-planned the truck: $(sed -n 's/.*"outcome":"\([^"]*\)".*/\1/p' <<<"$out")"
}

status() {
  local ref
  ref="$(order_ref)"
  echo "Cymbal's view:"; ctl cy /shipments | tr '{' '\n' | grep "\"bookingRef\":\"$ref\"" || true
  echo "Cymbal's records:"; ctl cy "/shipments/meridian-forwarding.example/$ref/events" | grep -o '"description":"[^"]*"' || true
}

"$cmd"
