# End-to-end smoke tests: real ulpnode processes over real sockets. Runs
# every executable in dev/smoke (lib.sh is their shared helpers), or only
# those named:
#
#   dev/tools/smoke            # all
#   dev/tools/smoke push       # just dev/smoke/push
set -euo pipefail
. "$(dirname "$0")/common.sh"
# The scenarios export nowhere, whatever the developer's shell sets.
unset OTEL_EXPORTER_OTLP_ENDPOINT OTEL_EXPORTER_OTLP_TRACES_ENDPOINT ULP_OTEL_ENDPOINT
dir="$(repo_root)/dev/smoke"

tests=()
if (($#)); then
  for name in "$@"; do
    [[ -x "$dir/$name" && "$name" != *.sh ]] || { echo "smoke: no test $name in dev/smoke" >&2; exit 1; }
    tests+=("$dir/$name")
  done
else
  for f in "$dir"/*; do
    [[ -x "$f" && "$f" != *.sh ]] && tests+=("$f")
  done
fi

for t in "${tests[@]}"; do
  printf '\n· smoke/%s\n' "$(basename "$t")"
  "$t"
done
