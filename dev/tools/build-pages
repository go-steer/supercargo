# Builds the GitHub Pages site into DIR (default _site): every HTML page
# under docs/ at the same path (docs/proposals/x.html becomes
# proposals/x.html), and an index linking them and the main docs on
# GitHub. The pages are self-contained, so nothing else is copied.
#
#   dev/tools/build-pages [DIR]
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
out="${1:-$root/_site}"
repo="https://github.com/go-steer/supercargo"
rm -rf "$out"
mkdir -p "$out"

# esc TEXT: TEXT, safe inside HTML.
esc() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g' <<<"$1"; }

items=""
while IFS= read -r f; do
  rel="${f#"$root/docs/"}"
  mkdir -p "$out/$(dirname "$rel")"
  cp "$f" "$out/$rel"
  title="$(grep -o -m1 '<title>[^<]*</title>' "$f" | sed -e 's/<title>//' -e 's/<\/title>//' || true)"
  [[ -n $title ]] || title="$rel"
  items+="    <li><a href=\"$(esc "$rel")\">$(esc "$title")</a> <span class=\"path\">docs/$(esc "$rel")</span></li>"$'\n'
done < <(find "$root/docs" -name '*.html' -type f | sort)

cat >"$out/index.html" <<EOF
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>supercargo · pages</title>
<style>
  body { margin: 0; padding: 32px 24px; max-width: 860px; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; font-size: 15px; line-height: 1.6; background: #202124; color: #e8eaed; }
  h1 { font-size: 20px; margin: 0 0 4px; background: linear-gradient(90deg, #217bfe, #078efb, #a770ef, #ff5e62); -webkit-background-clip: text; background-clip: text; color: transparent; display: inline-block; }
  h2 { font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: #9aa0a6; margin: 28px 0 8px; }
  p { color: #9aa0a6; margin: 0; }
  ul { padding-left: 20px; }
  li { margin: 6px 0; }
  a { color: #8ab4f8; }
  .path { color: #9aa0a6; font-family: 'SF Mono', Consolas, monospace; font-size: 12px; margin-left: 8px; }
</style>
</head>
<body>
  <h1>supercargo</h1>
  <p>A Go implementation of a Universal Logistics Protocol demo: signed messages between companies, with AI assistants that propose and people who decide.</p>
  <h2>Pages</h2>
  <ul>
$items  </ul>
  <h2>Docs (on GitHub)</h2>
  <ul>
    <li><a href="$repo/blob/main/docs/README.md">The docs index</a>: guides, proposals, reference</li>
    <li><a href="$repo/blob/main/docs/DESIGN.md">The design</a></li>
    <li><a href="$repo">The repository</a></li>
  </ul>
</body>
</html>
EOF
echo "built $out: $(find "$out" -name '*.html' | wc -l) page(s)"
