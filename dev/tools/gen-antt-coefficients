"""Generate internal/antt/coefficients.go from the Diário Oficial da União:
Resolução ANTT nº 6.034 de 18 de janeiro de 2024, Anexo II (the minimum
road freight coefficients, tables A to D). Standard library only.

    dev/tools/gen-antt-coefficients            # fetch the gazette page
    dev/tools/gen-antt-coefficients page.html  # or read a saved copy

The tables are read cell by cell, so an empty cell (an axle count the
resolution doesn't price for a load type) stays empty. The gazette's values
are kept as published, anomalies included; the Go file is regenerated,
never edited.
"""

import html
import pathlib
import re
import sys
import urllib.request

URL = "https://www.in.gov.br/en/web/dou/-/resolucao-n-6.034-de-18-de-janeiro-de-2024-538363035"
# QualP's load_type enum, in the order of the ANTT's table rows.
LOAD_TYPES = ["granel_solido", "granel_liquido", "frigorificada", "conteineirizada", "geral", "neogranel",
              "perigosa_granel_solido", "perigosa_granel_liquido", "perigosa_frigorificada",
              "perigosa_conteineirizada", "perigosa_geral", "granel_pressurizada"]
AXES = [2, 3, 4, 5, 6, 7, 9]
TABLES = ["A", "B", "C", "D"]
HEADER = '''// Copyright 2026 Google LLC
//
// Licensed under the Apache License, Version 2.0 (the "License");
// you may not use this file except in compliance with the License.
// You may obtain a copy of the License at
//
//     http://www.apache.org/licenses/LICENSE-2.0
//
// Unless required by applicable law or agreed to in writing, software
// distributed under the License is distributed on an "AS IS" BASIS,
// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
// See the License for the specific language governing permissions and
// limitations under the License.

// Code generated by dev/tools/gen-antt-coefficients from the Diário Oficial
// da União, Resolução ANTT nº 6.034 de 18 de janeiro de 2024, Anexo II (the
// coefficients of the minimum road freight floors). DO NOT EDIT.

package antt

// coefficients are the published CCD (R$/km) and CC (R$) by table, load
// type and loaded axles; a missing axle count is a combination the
// resolution doesn't price for that load type.
var coefficients = map[string]map[string]map[int]coefficient{
'''


def cells(row):
    return [html.unescape(re.sub(r"\s+", " ", re.sub(r"<[^>]+>", " ", c))).strip()
            for c in re.findall(r"<t[dh][^>]*>(.*?)</t[dh]>", row, re.S)]


def number(s):
    s = s.strip()
    return None if not s else float(s.replace(".", "").replace(",", "."))


def parse(page):
    tables = re.findall(r"<table.*?</table>", page[page.index("ANEXO II"):], re.S)[:4]
    if len(tables) != 4:
        sys.exit(f"found {len(tables)} tables after ANEXO II, want 4")
    out = {}
    for name, table in zip(TABLES, tables):
        rows, current = [], None
        for row in re.findall(r"<tr.*?</tr>", table, re.S):
            c = cells(row)
            if any("CCD" in x for x in c):
                k = next(i for i, x in enumerate(c) if "CCD" in x)
                current = {"ccd": c[k + 2:]}
                rows.append(current)
            elif any("(CC)" in x for x in c) and current is not None:
                k = next(i for i, x in enumerate(c) if "(CC)" in x)
                current["cc"] = c[k + 2:]
        if len(rows) != len(LOAD_TYPES):
            sys.exit(f"table {name}: {len(rows)} load types, want {len(LOAD_TYPES)}")
        out[name] = rows
    return out


def render(tables):
    lines = [HEADER.rstrip("\n")]
    for name in TABLES:
        lines.append(f'\t"{name}": {{')
        for load, row in zip(LOAD_TYPES, tables[name]):
            pairs = []
            for ax, ccd, cc in zip(AXES, row["ccd"], row["cc"]):
                a, b = number(ccd), number(cc)
                if a is not None and b is not None:
                    pairs.append(f"{ax}: {{{a}, {b}}}")
            lines.append(f'\t\t"{load}": {{{", ".join(pairs)}}},')
        lines.append("\t},")
    lines.append("}")
    return "\n".join(lines) + "\n"


def main():
    if len(sys.argv) > 1:
        page = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8", errors="replace")
    else:
        req = urllib.request.Request(URL, headers={"User-Agent": "Mozilla/5.0"})
        page = urllib.request.urlopen(req, timeout=60).read().decode("utf-8", "replace")
    out = pathlib.Path(__file__).resolve().parents[2] / "internal/antt/coefficients.go"
    out.write_text(render(parse(page)), encoding="utf-8")
    print(f"wrote {out}; run gofmt -w on it")


if __name__ == "__main__":
    main()
